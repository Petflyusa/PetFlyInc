<%- include('partials/header', { currentPage: 'portal', pageTitle: 'Set Your Password - Pet Fly Inc' }) %>
<style>.portal-access{max-width:440px;margin:8rem auto 4rem;padding:2rem;border:1px solid var(--warm-gray-300);background:#fff}.portal-access label{display:block;margin-top:1rem;font-size:.85rem}.portal-access input{width:100%;padding:.75rem;border:1px solid var(--warm-gray-300);font:inherit}.portal-access button{margin-top:1.5rem;width:100%}.portal-error{color:#a02d2d}</style>
<main class="portal-access"><span class="section-label">Client Portal</span><h1>Create your password</h1><p>Please replace the initial password issued by Pet Fly before continuing.</p><% if(error){ %><p class="portal-error"><%= error %></p><% } %><form method="post" action="/portal/change-password"><label>New password<input type="password" name="password" autocomplete="new-password" minlength="8" required></label><label>Confirm password<input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required></label><button class="btn-primary" type="submit">Save password</button></form></main>
<%- include('partials/footer', { footer: { company_name: 'Pet Fly Inc' } }) %>
