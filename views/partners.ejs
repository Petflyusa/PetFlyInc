<%- include('partials/header', { currentPage: 'registry', pageTitle: 'PetConnect Partners | Pet Fly Inc' }) %>
<main class="page-header petconnect-hero"><div class="container"><span class="section-label">PetConnect partners</span><h1>Nearby help for pets and families.</h1><p>Find verified veterinary hospitals, shelters, groomers, and pet travel specialists.</p><div class="hero-actions"><a class="btn-primary" href="/partner/register">Join as a partner</a><a class="btn-outline-public" href="/partner/login">Partner sign in</a></div></div></main><section class="section"><div class="container"><form class="petconnect-filters" method="get"><select name="type"><option value="">All partner types</option><% types.forEach(function(type) { %><option value="<%= type.slug %>" <%= selectedType === type.slug ? 'selected' : '' %>><%= type.label %></option><% }) %></select><select name="country"><option value="">United States &amp; Canada</option><option value="US" <%= selectedCountry === 'US' ? 'selected' : '' %>>United States</option><option value="CA" <%= selectedCountry === 'CA' ? 'selected' : '' %>>Canada</option></select><button class="btn-primary" type="submit">Filter</button></form><% if (!partners.length) { %><div class="empty-state-public"><p>No partners match these filters yet.</p></div><% } else { %><div class="partner-grid"><% partners.forEach(function(partner) { %><article class="partner-card"><span class="section-label"><%= partner.type_label %></span><h2><%= partner.company_name %></h2><p><%= [partner.city, partner.state, partner.country].filter(Boolean).join(', ') %></p><p><%= partner.phone || partner.email %></p><% if (partner.website) { %><a class="text-link" href="<%= partner.website %>" rel="noopener" target="_blank">Visit website</a><% } %></article><% }) %></div><% } %></div></section><%- include('partials/footer') %>
