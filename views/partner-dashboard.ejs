<%- include('partials/header', { currentPage: 'registry', pageTitle: 'Partner Dashboard | PetConnect' }) %><main class="section"><div class="container"><div class="section-header-public"><div><span class="section-label"><%= partner.type_label %></span><h1><%= partner.company_name %></h1><p>Alerts sent to your organization.</p></div><a class="btn-outline-public" href="/partners">Partner directory</a></div><% if (!alerts.length) { %><div class="empty-state-public"><p>No alerts have been delivered to this account yet.</p></div><% } else { %><div class="alert-grid"><% alerts.forEach(function(alert) { %><a class="alert-card" href="/alert/<%= alert.id %>"><div><span class="alert-badge <%= alert.alert_type %>"><%= alert.alert_type %></span><h3><%= alert.pet_name %></h3><p><%= alert.species %></p><p class="pet-meta"><%= [alert.last_seen_city, alert.last_seen_state].filter(Boolean).join(', ') %></p></div></a><% }) %></div><% } %></div></main><%- include('partials/footer') %>
