<%- include('partials/header', { currentPage: 'portal', pageTitle: 'Client Portal - Pet Fly Inc' }) %>
<style>.portal-access{max-width:440px;margin:8rem auto 4rem;padding:2rem;border:1px solid var(--warm-gray-300);background:#fff}.portal-access label{display:block;margin-top:1rem;font-size:.85rem}.portal-access input{width:100%;padding:.75rem;border:1px solid var(--warm-gray-300);font:inherit}.portal-access button{margin-top:1.5rem;width:100%}.portal-error{color:#a02d2d}</style>
<main class="portal-access"><span class="section-label">Client Portal</span><h1>Track your relocation</h1><p>Sign in to view your pets, relocation progress, documents, and updates.</p><% if(error){ %><p class="portal-error"><%= error %></p><% } %><form method="post" action="/portal/login"><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn-primary" type="submit">Sign in</button></form></main>
<%- include('partials/footer', { footer: { company_name: 'Pet Fly Inc' } }) %>
