<%- include('partials/header', { currentPage: 'portal', pageTitle: 'Client Portal - Pet Fly Inc' }) %>
<style>
  .portal-access-shell{max-width:980px;margin:7rem auto 4rem;padding:0 1.5rem}.portal-hero{min-height:260px;padding:3.5rem 3rem;display:flex;align-items:end;color:#fff;background:linear-gradient(90deg,rgba(12,18,22,.86),rgba(12,18,22,.2)),url('/images/client-login-hero.jpg') center 54%/cover}.portal-hero h1{max-width:560px;margin:.35rem 0 0;font-size:clamp(2rem,4vw,3.2rem)}.portal-access{max-width:440px;margin:-2rem 3rem 0 auto;position:relative;padding:2rem;border:1px solid var(--warm-gray-300);background:#fff;box-shadow:0 14px 35px rgba(24,44,62,.12)}.portal-access label{display:block;margin-top:1rem;font-size:.85rem}.portal-access input{width:100%;padding:.75rem;border:1px solid var(--warm-gray-300);font:inherit}.portal-access button{margin-top:1.5rem;width:100%}.portal-error{color:#a02d2d}@media(max-width:650px){.portal-access-shell{padding:0 1rem;margin-top:6rem}.portal-hero{min-height:240px;padding:2rem 1.25rem}.portal-access{margin:-1rem 1rem 0;padding:1.5rem}}
</style>
<main class="portal-access-shell"><section class="portal-hero"><div><span class="section-label" style="color:#fff">Client Portal</span><h1>Track your relocation</h1></div></section><section class="portal-access"><p>Sign in to view your pets, relocation progress, documents, and updates.</p><% if(error){ %><p class="portal-error"><%= error %></p><% } %><form method="post" action="/portal/login"><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn-primary" type="submit">Sign in</button></form></section></main>
<%- include('partials/footer', { footer: { company_name: 'Pet Fly Inc' } }) %>
