<%- include('partials/header', { currentPage: 'portal', pageTitle: 'Client Portal - Pet Fly Inc' }) %>
<style>.portal-access-shell{max-width:980px;margin:0 auto 4rem;padding:var(--space-xl) 1.5rem}.portal-access{max-width:440px;margin:0 auto;padding:2rem;border:1px solid var(--warm-gray-300);background:#fff}.portal-access label{display:block;margin-top:1rem;font-size:.85rem}.portal-access input{width:100%;padding:.75rem;border:1px solid var(--warm-gray-300);font:inherit}.portal-access button{margin-top:1.5rem;width:100%}.portal-error{color:#a02d2d}</style>
<section class="page-header"><img class="page-header-video" src="/images/client-login-hero.jpg" alt="Pet ready for relocation"><div class="page-header-overlay"></div><div class="container"><span class="section-label">Client Portal</span><h1>Track your relocation</h1><p>Follow your pets' journey, documents, and progress in one place.</p></div></section>
<main class="portal-access-shell"><section class="portal-access"><p>Sign in to view your pets, relocation progress, documents, and updates.</p><% if(error){ %><p class="portal-error"><%= error %></p><% } %><form method="post" action="/portal/login"><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn-primary" type="submit">Sign in</button></form></section></main>
<%- include('partials/footer', { footer: { company_name: 'Pet Fly Inc' } }) %>
