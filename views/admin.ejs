<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel — Pet Fly Inc</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>

<div id="adminApp">

  <header class="admin-mobile-header">
    <button id="adminMenuToggle" class="admin-menu-toggle" type="button" aria-label="Open navigation" aria-controls="adminSidebar" aria-expanded="false">
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>
    <div class="admin-mobile-brand"><i class="fas fa-paw" aria-hidden="true"></i> Pet Fly Admin</div>
  </header>

  <!-- Sidebar -->
  <aside id="adminSidebar" class="sidebar">
    <div class="sidebar-logo">
      <i class="fas fa-paw"></i> Pet Fly Admin
    </div>
    <nav class="sidebar-nav">
      <button class="nav-btn active" data-section="dashboard" onclick="showSection('dashboard')">
        <i class="fas fa-th-large"></i> Dashboard
      </button>
      <button class="nav-btn" data-section="quotes" onclick="showSection('quotes')">
        <i class="fas fa-file-invoice"></i> Quote Requests
        <span class="badge" id="badgeQuotes">0</span>
      </button>
      <button class="nav-btn" data-section="contacts" onclick="showSection('contacts')">
        <i class="fas fa-envelope"></i> Contact Messages
        <span class="badge" id="badgeContacts">0</span>
      </button>
      <button class="nav-btn" data-section="contracts" onclick="showSection('contracts')">
        <i class="fas fa-file-signature"></i> Contracts
      </button>
      <button class="nav-btn" data-section="email-center" onclick="showSection('email-center')">
        <i class="fas fa-envelope-open-text"></i> Email Center
      </button>
      <button class="nav-btn petconnect-parent" type="button" onclick="togglePetConnectNav()">
        <i class="fas fa-paw"></i> PetConnect <i class="fas fa-chevron-down pc-nav-chevron"></i>
      </button>
      <div id="petconnectSubnav" class="admin-subnav">
        <button class="nav-btn nav-subbtn" data-section="petconnect-overview" onclick="showSection('petconnect-overview')">Overview</button>
        <button class="nav-btn nav-subbtn" data-section="petconnect-members" onclick="showSection('petconnect-members')">Members</button>
        <button class="nav-btn nav-subbtn" data-section="petconnect-pets" onclick="showSection('petconnect-pets')">Pets</button>
        <button class="nav-btn nav-subbtn" data-section="petconnect-alerts" onclick="showSection('petconnect-alerts')">Alerts</button>
        <button class="nav-btn nav-subbtn" data-section="petconnect-partners" onclick="showSection('petconnect-partners')">Organizations</button>
      </div>
      <button class="nav-btn" data-section="content" onclick="showSection('content')">
        <i class="fas fa-edit"></i> Landing Content
      </button>
      <button class="nav-btn" data-section="countries" onclick="showSection('countries')">
        <i class="fas fa-globe"></i> Countries
      </button>
      <button class="nav-btn" data-section="airlines" onclick="showSection('airlines')">
        <i class="fas fa-plane"></i> Airlines
      </button>
    </nav>
    <div class="sidebar-bottom">
      <a href="/" class="sidebar-link"><i class="fas fa-external-link-alt"></i> View Site</a>
      <button class="sidebar-link" onclick="logout()" style="background:none;border:none;cursor:pointer;color:rgba(247,245,240,0.5);font-family:inherit;font-size:inherit;">
        <i class="fas fa-sign-out-alt"></i> Logout
      </button>
    </div>
  </aside>
  <div id="adminNavOverlay" class="admin-nav-overlay" aria-hidden="true"></div>

  <!-- Main Content -->
  <main class="main-content">

    <!-- Dashboard -->
    <section id="section-dashboard" class="admin-section active">
      <div class="section-header">
        <h1>Dashboard</h1>
      </div>
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-icon" style="background:#f5f0e8;color:#c4622d;"><i class="fas fa-file-invoice"></i></div>
          <div>
            <div class="stat-num" id="dashQuotes">0</div>
            <div class="stat-lbl">Total Quotes</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background:#f5f0e8;color:#c4622d;"><i class="fas fa-clock"></i></div>
          <div>
            <div class="stat-num" id="dashPending">0</div>
            <div class="stat-lbl">Pending</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background:#f5f0e8;color:#c4622d;"><i class="fas fa-envelope"></i></div>
          <div>
            <div class="stat-num" id="dashContacts">0</div>
            <div class="stat-lbl">Messages</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background:#f5f0e8;color:#c4622d;"><i class="fas fa-check-circle"></i></div>
          <div>
            <div class="stat-num" id="dashCompleted">0</div>
            <div class="stat-lbl">Completed</div>
          </div>
        </div>
      </div>
      <div class="recent-section">
        <h2>Recent Quote Requests</h2>
        <div id="recentQuotes"></div>
      </div>
    </section>

    <!-- Quote Requests -->
    <section id="section-quotes" class="admin-section">
      <div class="section-header">
        <h1>Quote Requests</h1>
        <button class="btn-outline" onclick="loadQuotes()"><i class="fas fa-sync"></i> Refresh</button>
      </div>
      <div id="quotesTable"></div>
    </section>

    <!-- Contact Messages -->
    <section id="section-contacts" class="admin-section">
      <div class="section-header">
        <h1>Contact Messages</h1>
        <button class="btn-outline" onclick="loadContacts()"><i class="fas fa-sync"></i> Refresh</button>
      </div>
      <div id="contactsTable"></div>
    </section>

    <!-- Contracts -->
    <section id="section-contracts" class="admin-section">
      <div class="section-header">
        <h1>Contracts</h1>
        <button class="btn-primary-sm" onclick="newContract()"><i class="fas fa-plus"></i> New Contract</button>
      </div>
      <div id="contractsTable"></div>
    </section>

    <section id="section-email-center" class="admin-section">
      <div class="section-header"><h1>Email Center</h1><button class="btn-outline" onclick="loadEmailTemplates()"><i class="fas fa-sync"></i> Refresh</button></div>
      <p id="emailCenterHealth" class="email-center-health">SMTP status: checking...</p>
      <div class="email-center-grid"><div><div id="emailTemplateList" class="email-template-list"></div></div><div class="email-preview-panel"><p class="email-preview-label">Subject</p><h2 id="emailTemplateSubject">Choose a template</h2><iframe id="emailTemplatePreview" title="Email template preview" sandbox=""></iframe><details><summary>Plain-text fallback</summary><pre id="emailTemplateText"></pre></details><div class="email-test-row"><input id="emailTemplateTestRecipient" class="field-input" type="email" placeholder="Send test to email address"><button class="btn-primary-sm" onclick="sendEmailTemplateTest()"><i class="fas fa-paper-plane"></i> Send test</button></div></div></div>
    </section>

    <section id="section-petconnect-overview" class="admin-section"><div class="section-header"><h1>PetConnect Overview</h1><button class="btn-outline" onclick="loadPetConnectOverview()"><i class="fas fa-sync"></i> Refresh</button></div><p id="emailHealthStatus" style="margin:0 0 1rem;color:var(--text-muted);">SMTP status: checking...</p><div class="stats-row pc-summary-grid"><button class="stat-card pc-summary-card" onclick="showSection('petconnect-members')"><span class="stat-icon"><i class="fas fa-users"></i></span><span><span class="stat-num" id="pcSummaryMembers">0</span><span class="stat-lbl">Registered members</span><small id="pcSummaryMembersMeta">0 verified</small></span></button><button class="stat-card pc-summary-card" onclick="showSection('petconnect-pets')"><span class="stat-icon"><i class="fas fa-paw"></i></span><span><span class="stat-num" id="pcSummaryPets">0</span><span class="stat-lbl">Registered pets</span><small id="pcSummaryPetsMeta">0 missing</small></span></button><button class="stat-card pc-summary-card" onclick="showSection('petconnect-alerts')"><span class="stat-icon"><i class="fas fa-bullhorn"></i></span><span><span class="stat-num" id="pcSummaryAlerts">0</span><span class="stat-lbl">Missing-pet alerts</span><small id="pcSummaryAlertsMeta">0 active</small></span></button><button class="stat-card pc-summary-card" onclick="showSection('petconnect-partners')"><span class="stat-icon"><i class="fas fa-building"></i></span><span><span class="stat-num" id="pcSummaryPartners">0</span><span class="stat-lbl">Organizations</span><small id="pcSummaryPartnersMeta">0 active</small></span></button></div></section>
    <section id="section-petconnect-members" class="admin-section"><div class="section-header"><h1>PetConnect Members</h1></div><div class="pc-filterbar"><input id="pcMemberSearch" placeholder="Search name, email, or phone"><select id="pcMemberVerified"><option value="">All verification</option><option value="verified">Verified</option><option value="pending">Pending</option></select><select id="pcMemberCountry"><option value="">All countries</option><option value="US">United States</option><option value="CA">Canada</option></select><select id="pcMemberAlerts"><option value="">All email alerts</option><option value="on">Alerts on</option><option value="off">Alerts off</option></select><button class="btn-primary-sm" onclick="loadPetConnectMembers()">Filter</button></div><div id="petconnectMembers"></div></section>
    <section id="section-petconnect-pets" class="admin-section"><div class="section-header"><h1>Registered Pets</h1></div><div class="pc-filterbar"><input id="pcPetSearch" placeholder="Search pet, microchip, or owner"><select id="pcPetSpecies"><option value="">All species</option><option>Dog</option><option>Cat</option><option>Bird</option><option>Other</option></select><select id="pcPetMissing"><option value="">All statuses</option><option value="yes">Missing</option><option value="no">Not missing</option></select><button class="btn-primary-sm" onclick="loadPetConnectPets()">Filter</button></div><div id="petconnectPets"></div></section>
    <section id="section-petconnect-alerts" class="admin-section"><div class="section-header"><h1>Missing-Pet Alerts</h1></div><div class="pc-filterbar"><input id="pcAlertSearch" placeholder="Search pet, owner, or location"><select id="pcAlertType"><option value="">Lost &amp; found</option><option value="lost">Lost</option><option value="found">Found</option></select><select id="pcAlertStatus"><option value="">All statuses</option><option value="active">Active</option><option value="found">Found</option><option value="closed">Closed</option></select><select id="pcAlertCountry"><option value="">All countries</option><option value="US">United States</option><option value="CA">Canada</option></select><button class="btn-primary-sm" onclick="loadPetConnectAlerts()">Filter</button></div><div id="petconnectAlerts"></div></section>
    <section id="section-petconnect-partners" class="admin-section"><div class="section-header"><h1>PetConnect Organizations</h1><div><button class="btn-outline" onclick="downloadPartnerCsvTemplate()"><i class="fas fa-download"></i> CSV template</button> <button class="btn-outline" onclick="testEmailDelivery()"><i class="fas fa-envelope"></i> Test email</button> <button class="btn-primary-sm" onclick="newPetConnectPartner()"><i class="fas fa-plus"></i> Add organization</button></div></div><div class="pc-filterbar"><input id="pcPartnerSearch" placeholder="Search organization, contact, email, or location" onkeydown="if(event.key==='Enter')filterPetConnectPartners()"><select id="pcPartnerType"><option value="">All types</option></select><select id="pcPartnerActive"><option value="">All activity</option><option value="yes">Active</option><option value="no">Inactive</option></select><select id="pcPartnerVerified"><option value="">All verification</option><option value="yes">Verified</option><option value="no">Unverified</option></select><select id="pcPartnerInvite"><option value="">All invitations</option><option value="uninvited">Uninvited</option><option value="invited">Invited</option><option value="claimed">Claimed</option></select><select id="pcPartnerCountry"><option value="">All countries</option><option value="US">United States</option><option value="CA">Canada</option></select><select id="pcPartnerGeoStatus"><option value="">All geo statuses</option><option value="located">Located</option><option value="pending">Pending</option><option value="needs_review">Needs review</option><option value="failed">Failed</option></select><select id="pcPartnerPerPage" onchange="setPetConnectPartnerPerPage()"><option value="50">50 per page</option><option value="100">100 per page</option><option value="200">200 per page</option><option value="all">All</option></select><button class="btn-primary-sm" onclick="filterPetConnectPartners()">Filter</button></div><div class="pc-bulkbar"><input type="file" id="partnerCsvFile" accept=".csv,text/csv"><button class="btn-outline" onclick="previewPartnerCsv()">Review CSV</button><button class="btn-outline" onclick="retrySelectedPartnerGeocoding()"><i class="fas fa-location-dot"></i> Geocode selected</button><button class="btn-primary-sm" onclick="inviteSelectedPartners()">Invite selected</button><span id="partnerSelectionStatus">0 selected</span></div><div id="partnerCsvReview"></div><div id="petconnectPartners"></div><div id="partnerPagination" class="pc-pagination"></div></section>

    <!-- Landing Content -->
    <section id="section-content" class="admin-section">
      <div class="section-header">
        <h1>Landing Page Content</h1>
        <button class="btn-primary-sm" onclick="saveLandingContent()"><i class="fas fa-save"></i> Save All Changes</button>
      </div>
      <div id="landingContentEditor"></div>
    </section>

    <!-- Countries -->
    <section id="section-countries" class="admin-section">
      <div class="section-header">
        <h1>Country Regulations</h1>
        <button class="btn-primary-sm" onclick="addCountry()"><i class="fas fa-plus"></i> Add Country</button>
      </div>
      <div id="countriesTable"></div>
    </section>

    <!-- Airlines -->
    <section id="section-airlines" class="admin-section">
      <div class="section-header">
        <h1>Airline Regulations</h1>
        <button class="btn-primary-sm" onclick="addAirline()"><i class="fas fa-plus"></i> Add Airline</button>
      </div>
      <div id="airlinesTable"></div>
    </section>

  </main>
</div>

<!-- Modal -->
<div id="modal" class="modal" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle">Modal</h2>
      <button onclick="closeModal()" style="background:none;border:none;cursor:pointer;font-size:1.25rem;color:rgba(247,245,240,0.5);"><i class="fas fa-times"></i></button>
    </div>
    <div id="modalBody" class="modal-body"></div>
  </div>
</div>

    <script src="/admin/app.js?v=8"></script>
</body>
</html>
