<%- include('partials/header', { currentPage: 'dashboard', pageTitle: 'My Alerts | PetConnect' }) %>
<main class="section"><div class="container"><div class="section-header-public"><div><span class="section-label">PetConnect</span><h1>My alerts</h1></div><div class="hero-actions"><a class="btn-outline-public" href="/dashboard">Dashboard</a><a class="btn-primary" href="/dashboard/missing/new">New alert</a></div></div><% if (!alerts.length) { %><div class="empty-state-public"><p>You have not posted an alert.</p></div><% } else { %><div class="alert-grid"><% alerts.forEach(function(alert) { %><article class="alert-card"><div><span class="alert-badge <%= alert.alert_type %>"><%= alert.status %></span><h3><%= alert.pet_name %></h3><p><%= alert.species %> · <%= alert.alert_type %></p><p class="pet-meta"><%= [alert.last_seen_city, alert.last_seen_state].filter(Boolean).join(', ') %></p><a class="text-link" href="/alert/<%= alert.id %>">View alert</a><% if (alert.status === 'active') { %><form method="post" action="/dashboard/alerts/<%= alert.id %>/found"><button class="btn-outline-public" type="submit">Mark found</button></form><% } %></div></article><% }) %></div><% } %></div></main>
<%- include('partials/footer') %>
