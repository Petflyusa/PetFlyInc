<%- include('partials/header', { currentPage: 'register' }) %>
<main class="auth-shell">
  <section class="auth-card">
    <span class="section-label">PetConnect</span>
    <h1>Create your account</h1>
    <p class="auth-intro">Register your pets and help reunite missing animals with their families.</p>
    <% if (error) { %><p class="auth-error"><%= error %></p><% } %>
    <form method="post" action="/register" class="auth-form">
      <div class="form-grid">
        <label>First name<input name="first_name" autocomplete="given-name" required></label>
        <label>Last name<input name="last_name" autocomplete="family-name" required></label>
      </div>
      <label>Email<input type="email" name="email" autocomplete="email" required></label>
      <label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
      <label>Confirm password<input type="password" name="confirm_password" minlength="8" autocomplete="new-password" required></label>
      <label>Street address<input name="address_line" autocomplete="street-address"></label>
      <div class="form-grid">
        <label>Country<select name="country"><option value="US">United States</option><option value="CA">Canada</option></select></label>
        <label>State / Province<input name="state"></label>
      </div>
      <div class="form-grid">
        <label>City<input name="city"></label>
        <label>Postal code<input name="postal_code"></label>
      </div>
      <label>Phone <span>(optional)</span><input name="phone" autocomplete="tel"></label>
      <label class="checkbox-label"><input type="checkbox" name="terms" required> I agree to the PetConnect terms.</label>
      <button class="btn-primary" type="submit">Create account</button>
    </form>
    <p class="auth-footer">Already registered? <a href="/login">Sign in</a></p>
  </section>
</main>
<%- include('partials/footer') %>
