<%- include('partials/header', { currentPage: 'dashboard', pageTitle: 'Post an Alert | PetConnect' }) %>
<main class="auth-shell"><section class="auth-card wide"><span class="section-label">PetConnect alert</span><h1>Report a lost or found pet</h1><p class="auth-intro">Alerts are sent only to opted-in verified members and partners in the search area.</p><form method="post" action="/dashboard/missing/new" enctype="multipart/form-data" class="auth-form"><label>Pet<select name="pet_id" required><option value="">Select your registered pet</option><% pets.forEach(function(pet) { %><option value="<%= pet.id %>"><%= pet.pet_name %> (<%= pet.species %>)</option><% }) %></select></label><div class="form-grid"><label>Alert type<select name="alert_type"><option value="lost">Lost pet</option><option value="found">Found pet</option></select></label><label>Last seen date<input type="date" name="last_seen_date" value="<%= today %>" required></label></div><label>Location / address<input name="last_seen_location" placeholder="Street, park, or landmark"></label><div class="form-grid"><label>City<input name="last_seen_city" required></label><label>State / Province<input name="last_seen_state"></label></div><div class="form-grid"><label>Country<select name="last_seen_country"><option value="US">United States</option><option value="CA">Canada</option></select></label><label>Search radius<input type="number" min="1" max="1000" name="search_radius" value="100" required></label></div><div class="form-grid"><label>Unit<select name="radius_unit"><option value="mi">Miles</option><option value="km">Kilometers</option></select></label><label>Alert photo<input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif"></label></div><label>Contact information<input name="contact_info" placeholder="Phone or email shown on the alert"></label><label>Reward <span>(optional)</span><input name="reward" placeholder="Optional reward information"></label><label>Description<textarea name="description" rows="5" required></textarea></label><button class="btn-primary" type="submit">Publish alert</button></form></section></main>
<%- include('partials/footer') %>
