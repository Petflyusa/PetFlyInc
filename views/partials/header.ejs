<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1a1a1a">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <% const seoData = typeof seo !== 'undefined' ? seo : { title: 'Pet Fly Inc | International Pet Transportation', description: 'International pet transportation and relocation services.', canonicalUrl: 'https://petflyinc.com/', imageUrl: 'https://petflyinc.com/images/hero-bg.jpg', schema: null }; %>
  <meta name="description" content="<%= seoData.description %>">
  <link rel="canonical" href="<%= seoData.canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Pet Fly Inc">
  <meta property="og:title" content="<%= seoData.title %>">
  <meta property="og:description" content="<%= seoData.description %>">
  <meta property="og:url" content="<%= seoData.canonicalUrl %>">
  <meta property="og:image" content="<%= seoData.imageUrl %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoData.title %>">
  <meta name="twitter:description" content="<%= seoData.description %>">
  <meta name="twitter:image" content="<%= seoData.imageUrl %>">
  <link rel="alternate" hreflang="en" href="<%= seoData.canonicalUrl %>">
  <link rel="alternate" hreflang="x-default" href="<%= seoData.canonicalUrl %>">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : seoData.title %></title>
  <% if (seoData.schema) { %><script type="application/ld+json"><%- JSON.stringify(seoData.schema).replace(/</g, '\\u003c') %></script><% } %>
  <link rel="stylesheet" href="/css/style-v2.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script src="/js/i18n.js" defer></script>
  <style>
    .add-pet-btn {
      margin-top: var(--space-sm);
      background: rgba(189, 155, 90, 0.15);
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 0.65rem 1rem;
      font-size: 0.9rem;
      cursor: pointer;
      width: 100%;
      font-family: var(--font-sans);
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 4px;
    }
    .add-pet-btn:hover {
      background: rgba(189, 155, 90, 0.25);
    }
    .pet-entry .remove-pet-btn {
      background: rgba(220, 64, 64, 0.1);
      border: 1px solid #dc4040;
      color: #ff8080;
      cursor: pointer;
      font-size: 0.75rem;
      padding: 0.25rem 0.6rem;
      border-radius: 3px;
      transition: all 0.2s;
      flex-shrink: 0;
      font-family: var(--font-sans);
    }
    .pet-entry .remove-pet-btn:hover {
      background: rgba(220, 64, 64, 0.2);
    }
  </style>
</head>
<body>

  <a class="skip-link" href="#content-start">Skip to main content</a>

  <header id="siteHeader" role="banner">
    <div class="container">
      <a href="/" class="logo">
        <div class="logo-icon"><i class="fas fa-plane"></i></div>
        Pet Fly Inc
      </a>
      <nav aria-label="Primary navigation">
        <ul>
          <li><a href="/" <%= currentPage === 'index' ? 'class="active"' : '' %> data-i18n="nav.home">Home</a></li>
          <li class="services-nav-item">
            <a href="/service" <%= ['service', 'contract', 'quote', 'import-brokerage'].includes(currentPage) ? 'class="active"' : '' %> data-i18n="nav.services">Services</a>
            <i class="fas fa-chevron-down services-nav-chevron" aria-hidden="true"></i>
            <ul class="services-submenu" aria-label="Services">
              <li><a href="/quote" <%= currentPage === 'quote' ? 'class="active"' : '' %> data-i18n="nav.quote">Quote</a></li>
              <li><a href="/contract" <%= currentPage === 'contract' ? 'class="active"' : '' %> data-i18n="nav.contract">Contract</a></li>
              <li><a href="/import-brokerage" <%= currentPage === 'import-brokerage' ? 'class="active"' : '' %>>Import Brokerage</a></li>
            </ul>
          </li>
          <li><a href="/registry" <%= currentPage === 'registry' ? 'class="active"' : '' %>>PetConnect</a></li>
          <li><a href="/regulations" <%= currentPage === 'regulations' ? 'class="active"' : '' %> data-i18n="nav.regulations">Regulations</a></li>
          <li><a href="/contact" <%= currentPage === 'contact' ? 'class="active"' : '' %> data-i18n="nav.contact">Contact</a></li>
          <li><a href="/portal/login" class="client-login-btn" data-i18n="nav.clientLogin">Client Login</a></li>
        </ul>
      </nav>
      <label class="language-control" for="languageSelect">
        <span class="sr-only" data-i18n="language.label">Language</span>
        <i class="fas fa-globe" aria-hidden="true"></i>
        <select id="languageSelect" data-i18n-aria-label="language.label" aria-label="Language">
          <option value="en" data-i18n="language.english">English</option>
          <option value="es" data-i18n="language.spanish">Spanish</option>
          <option value="zh" data-i18n="language.chinese">Chinese</option>
        </select>
      </label>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <nav id="mobileNav" class="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
    <a href="/" data-i18n="nav.home">Home</a>
    <div class="mobile-services-group">
      <a href="/service" data-i18n="nav.services">Services</a>
      <a class="mobile-services-submenu" href="/quote" data-i18n="nav.quote">Quote</a>
      <a class="mobile-services-submenu" href="/contract" data-i18n="nav.contract">Contract</a>
      <a class="mobile-services-submenu" href="/import-brokerage">Import Brokerage</a>
    </div>
    <a href="/registry" data-i18n="nav.petconnect">PetConnect</a>
    <a href="/regulations" data-i18n="nav.regulations">Regulations</a>
    <a href="/contact" data-i18n="nav.contact">Contact</a>
    <a href="/portal/login" data-i18n="nav.clientLogin">Client Login</a>
  </nav>

<script>
  window.addEventListener('DOMContentLoaded', function() {
    var contentStart = document.getElementById('content-start') || document.querySelector('main');
    if (contentStart) contentStart.id = 'content-start';
    var menuButton = document.querySelector('.menu-toggle');
    var mobileNav = document.getElementById('mobileNav');
    if (menuButton && mobileNav) {
      menuButton.addEventListener('click', function() {
        var isOpen = mobileNav.classList.toggle('active');
        menuButton.classList.toggle('active', isOpen);
        menuButton.setAttribute('aria-expanded', String(isOpen));
        menuButton.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
        mobileNav.setAttribute('aria-hidden', String(!isOpen));
      });
      mobileNav.addEventListener('click', function(event) {
        if (event.target.closest('a')) {
          mobileNav.classList.remove('active');
          menuButton.classList.remove('active');
          menuButton.setAttribute('aria-expanded', 'false');
          menuButton.setAttribute('aria-label', 'Open navigation menu');
          mobileNav.setAttribute('aria-hidden', 'true');
        }
      });
    }
    var selector = document.getElementById('languageSelect');
    if (!selector || !window.PetFlyI18n) return;
    selector.value = PetFlyI18n.getLanguage();
    PetFlyI18n.apply(document);
    PetFlyI18n.observe(document.body);
    selector.addEventListener('change', function() { PetFlyI18n.setLanguage(selector.value); window.location.reload(); });
  });
  window.addEventListener('scroll', function() {
    var h = document.getElementById('siteHeader');
    if (window.scrollY > 60) { h.classList.add('scrolled'); }
    else { h.classList.remove('scrolled'); }
  });
</script>
