<%- include('partials/header', { currentPage: 'registry', pageTitle: 'Partner Registration | PetConnect' }) %><main class="auth-shell"><section class="auth-card wide"><span class="section-label">PetConnect partners</span><h1>Register your organization</h1><% if (error) { %><p class="auth-error"><%= error %></p><% } %><form class="auth-form" method="post" action="/partner/register"><label>Organization type<select name="partner_type_id" required><option value="">Select a type</option><% types.forEach(function(type) { %><option value="<%= type.id %>"><%= type.label %></option><% }) %></select></label><div class="form-grid"><label>Organization name<input name="company_name" required></label><label>Contact name<input name="contact_name" required></label></div><div class="form-grid"><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone"></label></div><label>Address<input name="address_line"></label><div class="form-grid"><label>City<input name="city" required></label><label>State / Province<input name="state"></label></div><div class="form-grid"><label>Country<select name="country"><option value="US">United States</option><option value="CA">Canada</option></select></label><label>Postal code<input name="postal_code"></label></div><label>Website<input type="url" name="website" placeholder="https://"></label><button class="btn-primary" type="submit">Register organization</button></form></section></main><%- include('partials/footer') %>
