<%- include('partials/header', { currentPage: 'registry', pageTitle: alert.pet_name + ' Alert | PetConnect' }) %>
<main class="section"><div class="container alert-detail"><a class="text-link" href="/registry">Back to alerts</a><article class="petconnect-panel"><div class="alert-detail-grid"><% if (alert.photo_filename || alert.pet_photo) { %><img src="<%= alert.photo_filename || alert.pet_photo %>" alt="<%= alert.pet_name %>"><% } else { %><div class="pet-photo-placeholder"><i class="fas fa-paw"></i></div><% } %><div><span class="alert-badge <%= alert.alert_type %>"><%= alert.alert_type %> · <%= alert.status %></span><h1><%= alert.pet_name %></h1><p><%= [alert.species, alert.breed, alert.color, alert.gender].filter(Boolean).join(' · ') %></p><dl><dt>Last seen</dt><dd><%= [alert.last_seen_location, alert.last_seen_city, alert.last_seen_state, alert.last_seen_country].filter(Boolean).join(', ') %></dd><dt>Date</dt><dd><%= alert.last_seen_date || 'Not provided' %></dd><dt>Description</dt><dd><%= alert.description || 'No additional details provided.' %></dd><% if (alert.reward) { %><dt>Reward</dt><dd><%= alert.reward %></dd><% } %><% if (alert.contact_info) { %><dt>Contact</dt><dd><%= alert.contact_info %></dd><% } %></dl></div></div></article></div></main>
<%- include('partials/footer') %>
