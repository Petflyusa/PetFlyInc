<%- include('partials/header', { currentPage: 'registry', pageTitle: 'Set Partner Password | PetConnect' }) %><main class="auth-shell"><section class="auth-card"><span class="section-label">PetConnect partners</span><h1>Set your password</h1><% if (error) { %><p class="auth-error"><%= error %></p><% } %><form class="auth-form" method="post" action="/partner/claim/<%= token %>"><label>Password<input type="password" name="password" minlength="8" required></label><label>Confirm password<input type="password" name="confirm_password" minlength="8" required></label><button class="btn-primary" type="submit">Activate account</button></form></section></main><%- include('partials/footer') %>
