<%- include('partials/header', { currentPage: 'registry', pageTitle: 'PetConnect | Pet Fly Inc' }) %>
<main class="page-header petconnect-hero"><div class="container"><span class="section-label">PetConnect</span><h1>Help reunite missing pets with their families.</h1><p>Register a pet, share a missing-pet alert, and connect with nearby pet professionals.</p><div class="hero-actions"><a class="btn-primary" href="/register">Create an account</a><a class="btn-outline-public" href="/login">Pet owner sign in</a><a class="btn-outline-public" href="/partners">Find a partner</a></div></div></main>
<section class="section microchip-lookup-section"><div class="container"><div class="section-header-public"><div><span class="section-label">PetConnect</span><h2>Found a pet?</h2><p>Search a microchip to contact a registered owner privately.</p></div></div><form class="petconnect-filters" method="get" action="/registry"><input name="microchip" value="<%= microchip || '' %>" inputmode="numeric" pattern="[0-9 -]{9,20}" placeholder="Microchip number" required><button class="btn-primary" type="submit">Search microchip</button></form><% if (microchipSearched && !microchipPet) { %><div class="empty-state-public"><p>No public PetConnect record was found for that microchip number.</p></div><% } %><% if (microchipPet) { %><article class="microchip-result"><% if (microchipPet.photo_filename) { %><img src="<%= microchipPet.photo_filename %>" alt="<%= microchipPet.pet_name %>"><% } else { %><div class="pet-photo-placeholder"><i class="fas fa-paw"></i></div><% } %><div><h3><%= microchipPet.pet_name %></h3><p><%= [microchipPet.species, microchipPet.breed, microchipPet.color, microchipPet.gender].filter(Boolean).join(' · ') %></p><p>Microchip: <%= microchipPet.microchip_number %></p><% if (microchipPet.birth_date) { %><p>Birth date: <%= String(microchipPet.birth_date).slice(0, 10) %></p><% } %></div></article><% if (contact === 'sent') { %><p class="auth-success">Your message has been sent to the registered owner.</p><% } %><% if (contact === 'invalid') { %><p class="auth-error">Enter your name, a valid email address, and a message.</p><% } %><form class="auth-form microchip-contact-form" method="post" action="/registry/microchip-contact"><input type="hidden" name="microchip" value="<%= microchipPet.microchip_number %>"><label>Your name<input name="finder_name" required></label><label>Your email<input type="email" name="finder_email" required></label><label>Your phone <span>(optional)</span><input name="finder_phone"></label><label>Message<textarea name="message" rows="5" maxlength="3000" required></textarea></label><button class="btn-primary" type="submit">Send private message</button></form><% } %></div></section>
<section class="section petconnect-map-section"><div class="container"><div class="section-header-public"><div><span class="section-label">Live network</span><h2>Community alert map</h2></div></div><div id="petconnect-globe" class="petconnect-globe" data-scope="alerts" aria-label="Interactive map of PetConnect alerts"></div></div></section>
<section class="section"><div class="container"><div class="section-header-public"><div><span class="section-label">Current alerts</span><h2>Lost and found pets</h2></div><a class="text-link" href="/dashboard/missing/new">Post an alert</a></div><form class="petconnect-filters" method="get"><select name="type"><option value="">Lost &amp; found</option><option value="lost" <%= filters.alertType === 'lost' ? 'selected' : '' %>>Lost pets</option><option value="found" <%= filters.alertType === 'found' ? 'selected' : '' %>>Found pets</option></select><select name="species"><option value="">All species</option><% ['Dog','Cat','Bird','Other'].forEach(function(value) { %><option value="<%= value %>" <%= filters.species === value ? 'selected' : '' %>><%= value %></option><% }) %></select><select name="country"><option value="">United States &amp; Canada</option><option value="US" <%= filters.country === 'US' ? 'selected' : '' %>>United States</option><option value="CA" <%= filters.country === 'CA' ? 'selected' : '' %>>Canada</option></select><button class="btn-primary" type="submit">Filter</button></form><% if (!alerts.length) { %><div class="empty-state-public"><i class="fas fa-paw"></i><h2>No active alerts match these filters.</h2><p>PetConnect members can post an alert from their dashboard.</p></div><% } else { %><div class="alert-grid"><% alerts.forEach(function(alert) { %><a class="alert-card" href="/alert/<%= alert.id %>"><% if (alert.photo_filename || alert.pet_photo) { %><img src="<%= alert.photo_filename || alert.pet_photo %>" alt="<%= alert.pet_name %>"><% } else { %><div class="pet-photo-placeholder"><i class="fas fa-paw"></i></div><% } %><div><span class="alert-badge <%= alert.alert_type %>"><%= alert.alert_type %></span><h3><%= alert.pet_name %></h3><p><%= alert.species %><%= alert.breed ? ' · ' + alert.breed : '' %></p><p class="pet-meta"><i class="fas fa-location-dot"></i> <%= [alert.last_seen_city, alert.last_seen_state].filter(Boolean).join(', ') || 'Location shared privately' %></p></div></a><% }) %></div><% } %><% if (pages > 1) { %><nav class="pagination" aria-label="Alert pages"><% for (var n = 1; n <= pages; n++) { %><a class="<%= n === page ? 'active' : '' %>" href="?page=<%= n %>&type=<%= filters.alertType %>&species=<%= filters.species %>&country=<%= filters.country %>"><%= n %></a><% } %></nav><% } %></div></section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script><script src="/js/petconnect-globe.js" defer></script>
<%- include('partials/footer') %>
